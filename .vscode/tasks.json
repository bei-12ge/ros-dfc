{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: 配置 Release",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "release"],
      "problemMatcher": []
    },
    {
      "label": "CMake: 构建（默认 Release）",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "dependsOn": ["CMake: 配置 Release"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: 构建 Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "dependsOn": ["CMake: 配置 Debug"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: 配置 Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "problemMatcher": []
    },
    {
      "label": "运行全部测试 (ctest)",
      "type": "shell",
      "command": "ctest",
      "args": ["--test-dir", "build", "--output-on-failure"],
      "dependsOn": ["CMake: 构建（默认 Release）"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
